# ── Gemini ──────────────────────────────────────────────────────
# mock = chỉ dùng luật offline (miễn phí); live = gọi Gemini cho mọi tin nhắn
LLM_MODE=mock
GEMINI_API_KEY=
# Gemini 3.5 Flash-Lite: low-latency model with structured-output and thinking support.
GEMINI_MODEL=gemini-3.5-flash-lite
# Reasoning effort: low, medium (recommended), or high. Higher levels add latency and token use.
GEMINI_THINKING_LEVEL=medium
# Includes internal reasoning tokens as well as the final JSON answer.
GEMINI_MAX_OUTPUT_TOKENS=2200
# Thời gian chờ tối đa cho một call Gemini (ms). Đo thực tế 3,7–25,5s; UI stream
# trạng thái + có nút Dừng, và khi quá hạn sẽ trả lời nhanh từ dữ liệu mẫu (có nhãn).
GEMINI_TIMEOUT_MS=35000

# ── Quản trị ────────────────────────────────────────────────────
# Bắt buộc để mở /admin; cookie phiên chứa SHA-256 của giá trị này
ADMIN_PASSWORD=demo-admin

# ── Hiển thị ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Kidohomes Demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Dữ liệu & hiệu năng ─────────────────────────────────────────
# Để trống = data/kidohomes.db. Eval/test tự dùng data/eval.db
DATABASE_PATH=
CATALOG_CACHE_TTL_MS=60000
CHAT_RATE_LIMIT=20
# 1 = tắt log JSON
LOG_SILENT=0
